$version
    TOOL:	xmsim(64)	23.09-s013
$end
$timescale
    1 ns
$end

$scope module i2c_single_slave_tb $end
$var reg       1 !    clk $end
$var reg       1 "    rst $end
$var reg       7 #    address [6:0] $end
$var reg       8 $    master_data_in [7:0] $end
$var reg       1 %    enable $end
$var reg       1 &    rw $end
$var reg       8 '    master_data_out [7:0] $end
$var reg       1 (    ready $end
$var reg       8 )    slave_data_to_send [7:0] $end
$var reg       8 *    slave_data_received [7:0] $end
$var wire      1 +    sda  $end
$var wire      1 ,    scl  $end
$var reg       8 -    slave_rec_cg [7:0] $end
$var reg       8 .    slave_send_cg [7:0] $end
$var reg       3 /    slave_state_cg [2:0] $end
$var integer  32 0    master_assert_count $end
$var integer  32 1    slave_assert_count $end
$var integer  32 2    master_assert_pass $end
$var integer  32 3    slave_assert_pass $end
$var integer  32 4    master_assert_fail $end
$var integer  32 5    slave_assert_fail $end

$scope module master $end
$var parameter 32 6    ADDR_WIDTH $end
$var parameter 32 7    DATA_WIDTH $end
$var parameter 32 8    CLOCK_DIV $end
$var wire      1 9    clk  $end
$var wire      1 :    rst  $end
$var wire      7 ;    address [6:0] $end
$var wire      8 <    data_in [7:0] $end
$var wire      1 =    enable  $end
$var wire      1 >    rw  $end
$var reg       8 ?    data_out [7:0] $end
$var reg       1 @    ready $end
$var wire      1 +    i2c_sda  $end
$var wire      1 ,    i2c_scl  $end
$var reg       4 A    state [3:0] $end
$var reg       8 B    address_reg [7:0] $end
$var reg       8 C    write_data_reg [7:0] $end
$var reg       4 D    counter [3:0] $end
$var reg       3 E    clk_counter [2:0] $end
$var reg       1 F    sda_drive_en $end
$var reg       1 G    sda_out $end
$var reg       1 H    scl_enable $end
$var reg       1 I    i2c_clk $end

$scope module master_chk $end
$var wire      1 9    clk  $end
$var wire      1 :    rst  $end
$var wire      1 J    ready  $end
$var wire      1 =    enable  $end
$var wire      1 ,    scl  $end
$var wire      1 +    sda  $end
$var wire      4 K    state [3:0] $end
$upscope $end

$upscope $end


$scope module slave $end
$var parameter 32 L    ADDR_WIDTH $end
$var parameter 32 M    DATA_WIDTH $end
$var parameter  7 N    SLAVE_ADDR [6:0] $end
$var wire      1 +    sda  $end
$var wire      1 ,    scl  $end
$var wire      1 O    rst  $end
$var reg       8 P    data_received [7:0] $end
$var wire      8 Q    data_to_send [7:0] $end
$var reg       3 R    state [2:0] $end
$var reg       8 S    address_reg [7:0] $end
$var reg       4 T    counter [3:0] $end
$var reg       1 U    sda_drive_en $end
$var reg       1 V    start_event $end
$var reg       1 W    stop_event $end

$scope module slave_chk $end
$var wire      1 O    rst  $end
$var wire      1 ,    scl  $end
$var wire      1 +    sda  $end
$var wire      1 X    sda_drive_en  $end
$var wire      3 Y    slave_state [2:0] $end
$var wire      8 Z    data_received [7:0] $end
$var wire      8 Q    data_to_send [7:0] $end
$var wire      7 [    SLAVE_ADDR [6:0] $end
$var wire      8 \    address_reg [7:0] $end
$var parameter  3 ]    IDLE $end
$var parameter  3 ^    READ_ADDR $end
$var parameter  3 _    SEND_ACK $end
$var parameter  3 `    READ_DATA $end
$var parameter  3 a    SEND_ACK2 $end
$var parameter  3 b    WRITE_DATA $end
$upscope $end

$upscope $end


$scope task print_master_assert $end
$var reg       1 c    result $end
$upscope $end


$scope task print_slave_assert $end
$var reg       1 d    result $end
$upscope $end

$upscope $end

$enddefinitions $end
