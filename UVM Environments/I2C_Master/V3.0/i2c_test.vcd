$var wire      1 ,    i2c_scl  $end
$var reg       4 <    state [3:0] $end
$var reg       8 =    address_reg [7:0] $end
$var reg       8 >    write_data_reg [7:0] $end
$var reg       4 ?    counter [3:0] $end
$var reg       3 @    clk_counter [2:0] $end
$var reg       1 A    sda_drive_en $end
$var reg       1 B    sda_out $end
$var reg       1 C    scl_enable $end
$var reg       1 D    i2c_clk $end
$upscope $end

$upscope $end

