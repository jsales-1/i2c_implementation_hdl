database -open waves -into waves.shm -default
probe -create -shm i2c_multi_slave_tb.master.ready i2c_multi_slave_tb.master.rst i2c_multi_slave_tb.master.rw i2c_multi_slave_tb.master.scl_enable i2c_multi_slave_tb.master.sda_drive_en i2c_multi_slave_tb.master.sda_out i2c_multi_slave_tb.master.state i2c_multi_slave_tb.master.write_data_reg
run
